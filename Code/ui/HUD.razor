@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>

	<!-- Left: Fixed 5-slot inventory column -->
	<div class="inv-column">
		@for ( int i = 0; i < PlayerStats.AllSlotNames.Count; i++ )
		{
			var slotName = PlayerStats.AllSlotNames[i];
			bool isActive = i == PlayerStats.ActiveSlotIndex;
			bool isWeapon = i < PlayerStats.WeaponSlotCount;
			bool isEmpty = slotName == "Primary" || slotName == "Secondary"
				|| slotName == "Main Heal" || slotName == "Sub Heal"
				|| slotName == "Utility";
			<div class="inv-slot @(isEmpty ? "inv-empty" : "inv-filled") @(isActive ? "inv-active" : "")">
				<div class="inv-icon">
					@{
						var iconPath = SlotIconPath( slotName );
					}
					@if ( !isEmpty && iconPath != null )
					{
						<img src="@iconPath" />
					}
					else
					{
						@SlotIcon( slotName )
					}
				</div>
				<div class="inv-name">@SlotDisplayName( slotName )</div>
				@if ( isActive && !isEmpty )
				{
					<div class="inv-hint">@(isWeapon ? "[LMB]" : "[E]")</div>
				}
			</div>
		}
	</div>

	<!-- Bottom-left: Health + Stamina -->
	<div class="bottom-left">
		<div class="bar-row">
			<div class="bar-label">HP</div>
			<div class="bar-track">
				<div class="bar-fill health-fill" style="width:@HealthWidth"></div>
			</div>
			<div class="bar-value">@((int)PlayerStats.CurrentHealth)</div>
		</div>
		<div class="bar-row">
			<div class="bar-label">STM</div>
			<div class="bar-track">
				<div class="bar-fill stamina-fill" style="width:@StaminaWidth"></div>
			</div>
		</div>
		@if (PlayerStats.IsIncapacitated)
		{
			<div class="bar-row incap-row">
				<div class="bar-label incap-label">BLEED</div>
				<div class="bar-track">
					<div class="bar-fill bleedout-fill" style="width:@BleedOutWidth"></div>
				</div>
				<div class="bar-value incap-value">@((int)PlayerStats.BleedOutHealth)%</div>
			</div>
		}
	</div>

	<!-- Bottom-right: Ammo -->
	<div class="bottom-right">
		<div class="weapon-name">@PlayerStats.WeaponName</div>
		<div class="ammo-row">
			<span class="ammo-current">@PlayerStats.CurrentAmmo</span>
			<span class="ammo-sep"> / </span>
			<span class="ammo-reserve">@(PlayerStats.ReserveAmmo == -1 ? "∞" : PlayerStats.ReserveAmmo.ToString())</span>
		</div>
	</div>

	<!-- Directional damage indicators -->
	<div class="damage-indicator-container">
		@foreach (var ind in PlayerStats.DamageIndicatorsSnapshot)
		{
			<div class="damage-indicator" style=@($"transform: rotate({ind.Angle:F1}deg); opacity: {ind.Alpha:F2}") ></div>
		}
	</div>

	<!-- Pickup hint -->
	@if (!string.IsNullOrEmpty(PlayerStats.NearbyPickupHint))
	{
		<div class="pickup-hint">
			<span class="pickup-key">E</span>
			<span class="pickup-label"> Pick up @PlayerStats.NearbyPickupHint</span>
		</div>
	}

	<!-- Crosshair -->
	@if (!PlayerStats.IsDead)
	{
		<div class="crosshair">
			<div class="crosshair-dot"></div>
			<div class="crosshair-line crosshair-top"></div>
			<div class="crosshair-line crosshair-bottom"></div>
			<div class="crosshair-line crosshair-left"></div>
			<div class="crosshair-line crosshair-right"></div>
		</div>
	}

	<!-- Death Screen -->
	@if (PlayerStats.IsDead)
	{
		<div class="death-overlay">
			<div class="death-title">YOU DIED</div>
			<div class="death-buttons">
				<div class="death-btn" onclick=@Restart>RESTART</div>
			</div>
		</div>
	}

	<!-- Win Screen -->
	@if (PlayerStats.LevelComplete)
	{
		<div class="win-overlay">
			<div class="win-title">YOU MADE IT</div>
			<div class="stats-panel">
				<div class="stat-row"><span class="stat-label">Kills</span><span class="stat-value">@PlayerStats.TotalKills</span></div>
				<div class="stat-row"><span class="stat-label">Damage Taken</span><span class="stat-value">@PlayerStats.TotalDamageTaken</span></div>
				<div class="stat-row"><span class="stat-label">Times Downed</span><span class="stat-value">@PlayerStats.TimesIncapacitated</span></div>
				<div class="stat-row"><span class="stat-label">Accuracy</span><span class="stat-value">@($"{PlayerStats.AccuracyPercent:F0}%")</span></div>
			</div>
			<div class="death-buttons">
				<div class="death-btn" onclick=@Restart>PLAY AGAIN</div>
			</div>
		</div>
	}

</root>

@code
{
	private float lastHealth = 0f;
	private float lastStamina = 0f;
	private int lastAmmo = -1;
	private int lastReserve = -1;

	protected override void OnUpdate()
	{
		var h = PlayerStats.CurrentHealth;
		var s = PlayerStats.CurrentStamina;
		var a = PlayerStats.CurrentAmmo;
		var r = PlayerStats.ReserveAmmo;

		bool changed = lastHealth != h || lastStamina != s || lastAmmo != a || lastReserve != r;
		lastHealth = h;
		lastStamina = s;
		lastAmmo = a;
		lastReserve = r;

		if ( changed || PlayerStats.DamageIndicatorsSnapshot.Length > 0 )
			StateHasChanged();
	}

	protected override int BuildHash()
	{
		var h1 = System.HashCode.Combine(
			(int)PlayerStats.CurrentStamina,
			(int)PlayerStats.CurrentHealth,
			PlayerStats.CurrentAmmo,
			PlayerStats.ReserveAmmo,
			PlayerStats.WeaponName,
			PlayerStats.IsIncapacitated,
			PlayerStats.IsDead,
			(int)PlayerStats.BleedOutHealth
		);
		return System.HashCode.Combine( h1, PlayerStats.AllSlotNames.Count, PlayerStats.ActiveSlotIndex, PlayerStats.NearbyPickupHint, PlayerStats.LevelComplete, PlayerStats.TotalKills, PlayerStats.ShotsFired );
	}

	private static string SlotIconPath( string name ) => name switch
	{
		"Shotgun"    or "Remington" => "weapons/swb/remington/remington.png",
		"Pistol_New" or "Pistol" or "Colt" => "weapons/swb/colt/colt.png",
		_ => null
	};

	private static string SlotIcon( string name )
	{
		if ( name == "Health Kit" )  return "+";
		if ( name == "Pain Pills" )  return "P";
		if ( name == "AmmoPile" )    return "A";
		if ( name == "SMG" )         return "M";
		if ( name == "Bat" )         return "B";
		if ( name == "Axe" )         return "X";
		// Empty slot placeholders
		if ( name == "Primary" || name == "Secondary" ) return "—";
		if ( name == "Main Heal" || name == "Sub Heal" || name == "Utility" ) return "—";
		return "?";
	}

	private static string SlotDisplayName( string name )
	{
		if ( name == "Pistol_New" ) return "Pistol";
		return name;
	}

	private void Restart()
	{
		PlayerStats.IsDead = false;
		PlayerStats.IsIncapacitated = false;
		PlayerStats.BleedOutHealth = 100f;
		Game.ActiveScene.Load( Game.ActiveScene.Source );
	}

	private string HealthWidth   => PlayerStats.HealthMax   > 0 ? $"{PlayerStats.CurrentHealth  / PlayerStats.HealthMax   * 100f:F0}%" : "0%";
	private string StaminaWidth  => PlayerStats.StaminaMax  > 0 ? $"{PlayerStats.CurrentStamina / PlayerStats.StaminaMax  * 100f:F0}%" : "0%";
	private string BleedOutWidth => $"{PlayerStats.BleedOutHealth:F0}%";
}
